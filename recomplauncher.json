{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Moon River",
  "repo": "Zexyen/Moon-River",
  "inputs": [
    {
      "id": "game",
      "label": "Your Bayonetta 2 dump: the base game's .nsp or .xci (Update 1.2 merged in, or picked below), or an extracted folder with exefs and romfs from Update 1.2.",
      "formats": [
        { "type": "file", "extensions": ["nsp", "xci"], "requires": ["keys"] },
        { "type": "folder" }
      ]
    },
    {
      "id": "update",
      "label": "Update 1.2 (.nsp), unless your base game file already has it.",
      "role": "update",
      "optional": true,
      "formats": [{ "type": "file", "extensions": ["nsp", "xci"], "requires": ["keys"] }]
    },
    { "id": "keys", "label": "Your Nintendo Switch prod.keys", "role": "key", "shared": "switch.prod-keys" }
  ],
  "prepare": {
    "program": ["build/moon-river-launcher.exe", "MoonRiver-x86_64.AppImage", "build/moon-river-launcher"],
    "args": ["--prepare", "--dump={input:game}", "--update={input:update}", "--keys={input:keys}"],
    "label": "Translating and compiling the game from your dump",
    "done": ["{install}/targets/exefs/main.elf", "{install}/build/built_version"],
    "options": [
      {
        "id": "accept_modified",
        "label": "Accept a modified dump",
        "note": "Only if the check says your dump's files were changed, by a mod or a translation.",
        "default": false,
        "args": ["--accept-modified"]
      }
    ]
  },
  "start": {
    "program": ["moon-river-launcher.exe", "MoonRiver-x86_64.AppImage", "build/moon-river-launcher"],
    "args": ["--play"]
  },
  "system": {
    "windows": { "version": "10", "graphics": { "vulkan": "1.3" } },
    "linux": { "glibc": "2.35", "graphics": { "vulkan": "1.3" } }
  },
  "saves": ["{data}/userdata/save"],
  "folders": {
    "saves": [{ "path": "{data}/userdata/save" }],
    "logs": [{ "path": "{data}/logs" }]
  },
  "config": [
    { "id": "main", "format": "ini", "file": [{ "path": "{data}/config/graphics.ini" }] },
    { "id": "controllers", "format": "ini", "file": [{ "path": "{data}/config/controllers.ini" }] }
  ],
  "settings": [
    {
      "id": "window", "label": "Display mode", "group": "Display",
      "help": "Windowed, or the whole monitor the window is on.",
      "choices": [
        { "label": "Windowed", "set": { "window": "windowed" } },
        { "label": "Borderless", "set": { "window": "borderless" } },
        { "label": "Fullscreen", "set": { "window": "fullscreen" } }
      ],
      "defaults": { "window": "windowed" }
    },
    {
      "id": "window_size", "label": "Window size", "group": "Display",
      "help": "The size of the window in Windowed mode.",
      "choices": [
        { "label": "1280 x 720", "set": { "width": "1280", "height": "720" } },
        { "label": "1600 x 900", "set": { "width": "1600", "height": "900" } },
        { "label": "1920 x 1080", "set": { "width": "1920", "height": "1080" } },
        { "label": "2560 x 1440", "set": { "width": "2560", "height": "1440" } },
        { "label": "3840 x 2160", "set": { "width": "3840", "height": "2160" } }
      ],
      "defaults": { "width": "1280", "height": "720", "window": "windowed" },
      "when": { "window": "windowed" }
    },
    {
      "id": "vsync", "label": "Vertical sync", "group": "Display",
      "help": "Auto locks to a 60, 120 or 240 Hz display.",
      "choices": [
        { "label": "Auto", "set": { "vsync": "auto" } },
        { "label": "Display", "set": { "vsync": "display" } },
        { "label": "Clock", "set": { "vsync": "clock" } },
        { "label": "Off", "set": { "vsync": "off" } },
        { "label": "On", "set": { "vsync": "on" } },
        { "label": "Mailbox", "set": { "vsync": "mailbox" } }
      ],
      "defaults": { "vsync": "auto" }
    },
    {
      "id": "frame_rate", "label": "Frame rate", "group": "Display",
      "help": "60 is the console's. 90 and 120 are experimental.",
      "choices": [
        { "label": "60 fps", "set": { "frame_rate": "60" } },
        { "label": "90 fps", "set": { "frame_rate": "90" } },
        { "label": "120 fps", "set": { "frame_rate": "120" } }
      ],
      "defaults": { "frame_rate": "60" }
    },
    {
      "id": "resolution_scale", "label": "Internal resolution", "group": "Graphics",
      "help": "What the game renders at. 720p is the console's docked size.",
      "choices": [
        { "label": "0.5x", "set": { "resolution_scale": "0.5" } },
        { "label": "0.75x", "set": { "resolution_scale": "0.75" } },
        { "label": "720p", "set": { "resolution_scale": "1.0" } },
        { "label": "1.25x", "set": { "resolution_scale": "1.25" } },
        { "label": "1080p", "set": { "resolution_scale": "1.5" } },
        { "label": "1440p", "set": { "resolution_scale": "2.0" } },
        { "label": "2.5x", "set": { "resolution_scale": "2.5" } },
        { "label": "2160p (4K)", "set": { "resolution_scale": "3.0" } }
      ],
      "defaults": { "resolution_scale": "1.0" }
    },
    {
      "id": "aspect", "label": "Aspect ratio", "group": "Graphics",
      "help": "Keep 16:9 with bars, stretch to fill, or native Wide (21:9 / 32:9).",
      "choices": [
        { "label": "Fixed 16:9", "set": { "aspect": "keep" } },
        { "label": "Stretch", "set": { "aspect": "stretch" } },
        { "label": "Wide", "set": { "aspect": "wide" } }
      ],
      "defaults": { "aspect": "keep" }
    },
    {
      "id": "hdr", "label": "HDR", "group": "Graphics",
      "help": "Auto follows the desktop's HDR, and the scene's lights go above white.",
      "choices": [
        { "label": "Auto", "set": { "hdr": "auto" } },
        { "label": "Off", "set": { "hdr": "off" } },
        { "label": "On", "set": { "hdr": "on" } }
      ],
      "defaults": { "hdr": "auto" }
    },
    {
      "id": "hdr_paper_white", "label": "HDR white", "group": "Graphics", "advanced": true,
      "help": "How bright the game's white is with HDR on; Auto follows the desktop.",
      "choices": [
        { "label": "Auto", "set": { "hdr_paper_white": "auto" } },
        { "label": "100 nits", "set": { "hdr_paper_white": "100" } },
        { "label": "150 nits", "set": { "hdr_paper_white": "150" } },
        { "label": "200 nits", "set": { "hdr_paper_white": "200" } },
        { "label": "250 nits", "set": { "hdr_paper_white": "250" } },
        { "label": "300 nits", "set": { "hdr_paper_white": "300" } },
        { "label": "400 nits", "set": { "hdr_paper_white": "400" } }
      ],
      "defaults": { "hdr_paper_white": "auto" }
    },
    {
      "id": "hdr_peak", "label": "HDR peak", "group": "Graphics", "advanced": true,
      "help": "Your monitor's peak brightness in nits, for the scene's brightest parts.",
      "choices": [
        { "label": "Auto", "set": { "hdr_peak": "auto" } },
        { "label": "400 nits", "set": { "hdr_peak": "400" } },
        { "label": "600 nits", "set": { "hdr_peak": "600" } },
        { "label": "800 nits", "set": { "hdr_peak": "800" } },
        { "label": "1000 nits", "set": { "hdr_peak": "1000" } },
        { "label": "1500 nits", "set": { "hdr_peak": "1500" } },
        { "label": "2000 nits", "set": { "hdr_peak": "2000" } },
        { "label": "4000 nits", "set": { "hdr_peak": "4000" } }
      ],
      "defaults": { "hdr_peak": "auto" }
    },
    {
      "id": "button_prompts", "label": "Button prompts", "group": "Controls", "in": "controllers",
      "help": "Auto follows the controller or keyboard you use.",
      "choices": [
        { "label": "Auto", "set": { "general/button_prompts": "auto" } },
        { "label": "PlayStation", "set": { "general/button_prompts": "playstation" } },
        { "label": "Xbox", "set": { "general/button_prompts": "xbox" } },
        { "label": "Switch", "set": { "general/button_prompts": "switch" } },
        { "label": "Keyboard", "set": { "general/button_prompts": "keyboard" } }
      ],
      "defaults": { "general/button_prompts": "auto" }
    },
    {
      "id": "swap_confirm", "label": "Swap confirm", "group": "Controls", "in": "controllers",
      "help": "Menus only: B confirms and A goes back.",
      "choices": [
        { "label": "Off", "set": { "general/swap_confirm": "off" } },
        { "label": "On", "set": { "general/swap_confirm": "on" } }
      ],
      "defaults": { "general/swap_confirm": "off" }
    },
    {
      "id": "layout", "label": "Face buttons", "group": "Controls", "in": "controllers",
      "help": "Position uses Nintendo's layout; Printed letter follows the letters on Xbox and PlayStation pads.",
      "choices": [
        { "label": "Auto", "set": { "general/layout": "auto" } },
        { "label": "Position", "set": { "general/layout": "positional" } },
        { "label": "Printed letter", "set": { "general/layout": "labels" } }
      ],
      "defaults": { "general/layout": "auto" }
    }
  ],
  "actions": [
    { "id": "saves", "label": "Saves", "help": "Your save slots.", "open": "saves" },
    { "id": "logs", "label": "Logs", "help": "The game's logs from its last five runs, for a bug report.", "open": "logs" }
  ]
}
