<rml>
<head>
	<title>Moon River</title>
	<link type="text/rcss" href="launcher.rcss"/>
</head>
<body data-model="mr">

<!-- Persistent night-river scene shared across all five screens (moon and shimmer dim off the title screen) -->
<div class="stage">
	<div class="sky"></div>
	<img class="scene-moon" data-attr-src="moon_src"/>
	<div class="river"></div>
	<img class="scene-shimmer" data-attr-src="shimmer_src"/>
	<div class="vignette"></div>

	<!-- ======================================================================= title menu -->
	<div class="screen title" data-if="screen == 'title'" data-class-leaving="leaving">
		<img class="logo" src="img/logo.png"/>
		<div class="update-pill" data-if="update_tag != ''" data-event-click="update()">{{ update_tag }} is out</div>
		<div class="menu">
			<div data-for="m, i : menu" class="mi" data-class-on="m.selected" data-class-far="m.far"
				data-style-transform="m.transform" data-style-opacity="m.opacity" data-event-click="menu_click(i)">
				<div class="mi-halo"></div>
				<div class="mi-inner">
					<div class="mi-line left"></div>
					<span class="mi-label">{{ m.label }}</span>
					<span class="mi-tag" data-if="m.tag != ''">{{ m.tag }}</span>
					<div class="mi-line right"></div>
				</div>
			</div>
		</div>
		<div class="desc-wrap" data-class-bad="status_bad">
			<div class="hline"></div>
			<div class="desc">{{ menu_desc }}</div>
			<div class="hline"></div>
		</div>
		<div class="foot">
			<img class="ficon" src="img/icon.png"/>
			<div class="fl">{{ footer_info }}</div>
			<div class="grow"></div>
			<div class="hint" key="ok"><img class="gl" data-attr-src="glyph_ok"/><span>OK</span></div>
			<div class="hint" key="back"><img class="gl" data-attr-src="glyph_back"/><span>Back</span></div>
		</div>
	</div>

	<!-- ======================================================================= first run / your dump -->
	<div class="screen setup" data-if="screen == 'setup'" data-class-leaving="leaving">
		<div class="crumb">
			<img class="crumb-icon" src="img/icon.png" data-event-click="go('title')"/>
			<span class="crumb-home" data-event-click="go('title')">{{ app_name }}</span>
			<div class="crumb-sep"></div>
			<span class="crumb-cur">{{ built ? 'Your dump' : 'First run' }}</span>
		</div>
		<div class="stabs">
			<img class="gl tab-gl" data-attr-src="glyph_tab_l" data-event-click="dump_mode(dump_mode == 0 ? 1 : 0)"/>
			<div class="t" data-class-on="dump_mode == 1" data-event-click="dump_mode(1)">NSP / XCI</div>
			<div class="t" data-class-on="dump_mode == 0" data-event-click="dump_mode(0)">Extracted folder</div>
			<img class="gl tab-gl" data-attr-src="glyph_tab_r" data-event-click="dump_mode(dump_mode == 0 ? 1 : 0)"/>
		</div>
		<div class="lead">
			<h2>Point the launcher at your copy of the game</h2>
			<p data-if="dump_mode == 1">Select your own <em>NSP</em> or <em>XCI</em> files and <em>prod.keys</em> from your Nintendo Switch copy of Bayonetta 2 (version 1.2). Everything is extracted locally.</p>
			<p data-if="dump_mode == 0">Select a folder holding <em>exefs</em> and <em>romfs</em> extracted from your own Nintendo Switch copy of Bayonetta 2 (version 1.2).</p>
			<p>Nothing is downloaded or sent anywhere. You do this once, and updates rebuild only what changed.</p>
		</div>
		<div class="col setup-col">
			<div class="fld" data-if="dump_mode == 1">
				<div class="fld-label">Base game (NSP / XCI, or merged)</div>
				<div class="fld-row">
					<input type="text" class="inp autofocus" data-value="dump"/>
					<div class="btn" data-event-click="browse(0)"><span>Browse</span></div>
				</div>
			</div>
			<div class="fld" data-if="dump_mode == 1">
				<div class="fld-label">Update 1.2 (NSP, optional if merged)</div>
				<div class="fld-row">
					<input type="text" class="inp" data-value="update_pkg"/>
					<div class="btn" data-event-click="browse(1)"><span>Browse</span></div>
				</div>
			</div>
			<div class="fld" data-if="dump_mode == 1">
				<div class="fld-label">Console keys (prod.keys)</div>
				<div class="fld-row">
					<input type="text" class="inp" data-value="prod_keys"/>
					<div class="btn" data-event-click="browse(2)"><span>Browse</span></div>
				</div>
			</div>
			<div class="fld" data-if="dump_mode == 0">
				<div class="fld-label">Dump folder</div>
				<div class="fld-row">
					<input type="text" class="inp autofocus" data-value="dump"/>
					<div class="btn" data-event-click="browse(0)"><span>Browse</span></div>
				</div>
			</div>
			<div class="rw compact" data-if="dump_mode == 0" data-event-click="toggle_move()">
				<div class="sw" data-class-y="move_dump"><div class="knob"></div></div>
				<div class="k">
					<div class="rw-name">{{ move_dump ? 'Move the game data here' : 'Copy the game data here' }}</div>
					<div class="rw-note">{{ move_dump ? 'The romfs leaves your dump folder for the game folder; nothing is stored twice.' : 'Your dump stays whole. Free on the same drive, about 15 GB from another.' }}</div>
				</div>
			</div>
			<div class="rw compact" data-if="dump_modified || accept_modified" data-event-click="toggle_accept_modified()">
				<div class="sw" data-class-y="accept_modified"><div class="knob"></div></div>
				<div class="k">
					<div class="rw-name">Use a modified dump</div>
					<div class="rw-note">Some files differ from the supported version. It may build and run, or it may not; it is unsupported.</div>
				</div>
			</div>
			<div class="checks" data-if="checks.size > 0">
				<div data-for="c : checks" class="ck" data-class-done="c.state == 'done'" data-class-run="c.state == 'run'" data-class-wait="c.state == 'wait'" data-class-fail="c.state == 'fail'">
					<div class="d"></div>
					<div class="ck-text">{{ c.text }}</div>
					<div class="r">{{ c.right }}</div>
				</div>
			</div>
			<div class="acts">
				<div class="btn primary" data-if="!verified" data-event-click="check_dump()"><div class="btn-glow"></div><span>{{ checking ? 'Checking…' : 'Check dump' }}</span></div>
				<div class="btn primary" data-if="verified" data-event-click="start_build()"><div class="btn-glow"></div><span>Begin build</span></div>
				<div class="btn" data-event-click="go('title')"><span>Back</span></div>
			</div>
		</div>
		<div class="band2">{{ verified ? 'Your dump checks out. Begin the build.' : checking ? 'Checking your dump. This takes about a minute.' : (dump_mode == 1 ? 'Choose your NSP/XCI files and prod.keys, then check.' : 'Choose your dump folder, then check the dump.') }}</div>
		<div class="foot">
			<img class="ficon" src="img/icon.png"/>
			<div class="fl">{{ setup_footer }}</div>
			<div class="grow"></div>
			<div class="hint" key="e"><img class="gl" key="q" data-attr-src="glyph_tab_l"/><img class="gl" data-attr-src="glyph_tab_r"/><span>Source</span></div>
			<div class="hint" key="ok"><img class="gl" data-attr-src="glyph_ok"/><span>OK</span></div>
			<div class="hint" key="back"><img class="gl" data-attr-src="glyph_back"/><span>Back</span></div>
		</div>
	</div>

	<!-- ======================================================================= building -->
	<div class="screen build" data-if="screen == 'build'" data-class-leaving="leaving">
		<div class="crumb">
			<img class="crumb-icon" src="img/icon.png" data-event-click="go('title')"/>
			<span class="crumb-home" data-event-click="go('title')">{{ app_name }}</span>
			<div class="crumb-sep"></div>
			<span class="crumb-cur">Building</span>
		</div>
		<div class="steps">
			<div data-for="s : steps" class="st" data-class-done="s.state == 'done'" data-class-run="s.state == 'run'" data-class-fail="s.state == 'fail'">
				<span class="st-n">{{ s.num }}</span>
				<span class="st-name">{{ s.name }}</span>
				<div class="st-tail" data-if="s.state == 'run'"></div>
			</div>
		</div>
		<div class="ring-wrap">
			<img class="ring-disc" src="gen:builddisc"/>
			<img class="moon-fill-img" data-attr-src="'gen:moonfill?p=' + percent"/>
			<progress class="ring-prog" direction="clockwise" start-edge="top" data-attr-value="progress"></progress>
		</div>
		<div class="pct">{{ percent }}<span class="pct-sym">%</span></div>
		<div class="pctnote">{{ build_aside }}</div>
		<div class="log" data-if="show_log || build_error != ''">
			<div class="error" data-if="build_error != ''">{{ build_error }}</div>
			<div data-if="show_log">
				<div data-for="l : log" class="log-line">{{ l }}</div>
			</div>
		</div>
		<div class="bacts">
			<div class="btn autofocus" data-if="building" data-event-click="stop_build()"><span>Stop</span></div>
			<div class="btn primary autofocus" data-if="(!building || converting) &amp;&amp; built &amp;&amp; !stale" data-event-click="play()"><div class="btn-glow"></div><span>Play</span></div>
			<div class="btn autofocus" data-if="!building" data-event-click="start_build()"><span>{{ built ? 'Rebuild' : 'Build' }}</span></div>
			<div class="btn" data-event-click="toggle_log()"><span>{{ show_log ? 'Hide log' : 'Show log' }}</span></div>
		</div>
		<div class="band2">{{ build_line }}</div>
		<div class="foot">
			<img class="ficon" src="img/icon.png"/>
			<div class="fl">{{ build_footer }}</div>
			<div class="grow"></div>
			<div class="hint" key="ok"><img class="gl" data-attr-src="glyph_ok"/><span>OK</span></div>
			<div class="hint" key="back"><img class="gl" data-attr-src="glyph_back"/><span>Back</span></div>
		</div>
	</div>

	<!-- ======================================================================= mods -->
	<div class="screen mods" data-if="screen == 'mods'" data-class-leaving="leaving">
		<div class="crumb">
			<img class="crumb-icon" src="img/icon.png" data-event-click="go('title')"/>
			<span class="crumb-home" data-event-click="go('title')">{{ app_name }}</span>
			<div class="crumb-sep"></div>
			<span class="crumb-cur">Mods</span>
		</div>
		<div class="lead">
			<h2>Mods</h2>
			<p>Each mod goes in its own folder in the mods folder. That can be code patches (<em>.pchtxt</em>, <em>.ips</em>) or a <em>romfs</em> folder.</p>
			<p>Data mods apply at the next start. Code mods rebuild from the mods step, which takes about a minute.</p>
			<div class="acts">
				<div class="btn primary" id="mods_apply" data-if="mods_rebuild" data-event-click="start_build()"><div class="btn-glow"></div><span>Apply and rebuild</span></div>
				<div class="btn" id="mods_open" data-class-autofocus="mods.size == 0" data-event-click="open_mods()"><span>Open mods folder</span></div>
			</div>
		</div>
		<div class="col">
			<div class="rows" data-if="mods.size > 0">
				<div data-for="m, i : mods" class="rw mod-row autofocus" data-attr-id="'mod' + i" data-event-click="toggle_mod(i)">
					<div class="sw" data-class-y="m.on"><div class="knob"></div></div>
					<div class="k">
						<div class="rw-name">{{ m.name }}</div>
						<div class="rw-note">{{ m.note }}</div>
					</div>
					<div class="kind">{{ m.kind }}</div>
				</div>
			</div>
			<div class="empty" data-if="mods.size == 0">No mods yet. Put each one in its own folder in the mods folder: code patches (.pchtxt, .ips) or a romfs folder.</div>
			<div class="error" data-if="mods_error != ''">{{ mods_error }}</div>
		</div>
		<div class="band2">{{ mods_summary }}</div>
		<div class="foot">
			<img class="ficon" src="img/icon.png"/>
			<div class="grow"></div>
			<div class="hint" key="ok"><img class="gl" data-attr-src="glyph_ok"/><span>Turn on or off</span></div>
			<div class="hint" key="back"><img class="gl" data-attr-src="glyph_back"/><span>Back</span></div>
		</div>
	</div>

	<!-- ======================================================================= settings -->
	<div class="screen settings" data-if="screen == 'settings'" data-class-leaving="leaving">
		<div class="crumb">
			<img class="crumb-icon" src="img/icon.png" data-event-click="go('title')"/>
			<span class="crumb-home" data-event-click="go('title')">{{ app_name }}</span>
			<div class="crumb-sep"></div>
			<span class="crumb-cur">Settings</span>
		</div>
		<div class="stabs">
			<img class="gl tab-gl" data-attr-src="glyph_tab_l" data-event-click="tab(tab - 1)"/>
			<div class="t" data-class-on="tab == 0" data-event-click="tab(0)">Display</div>
			<div class="t" data-class-on="tab == 1" data-event-click="tab(1)">Graphics</div>
			<div class="t" data-class-on="tab == 2" data-event-click="tab(2)">Controls</div>
			<img class="gl tab-gl" data-attr-src="glyph_tab_r" data-event-click="tab(tab + 1)"/>
		</div>
		<div class="lead settings-lead">
			<h2>Settings</h2>
			<p>The in-game PC Settings panel (F1, or Start + Select) has these too, and more.</p>
			<p data-if="tab == 0">The window, the display and the frame rate.</p>
			<p data-if="tab == 1">What the game draws and how sharply.</p>
			<p data-if="tab == 2">Prompts and menu buttons. Gameplay buttons are rebound in the game's own panel.</p>
			<p class="small" data-if="tab == 1 &amp;&amp; tex_note != ''">{{ tex_note }}</p>
		</div>
		<div class="col settings-col">
			<div class="rows">
				<div data-for="s, i : settings" class="rw setting autofocus" data-attr-index="s.index" data-style-nav-up="i == 0 ? 'none' : 'vertical'">
					<div class="k">
						<div class="rw-name">{{ s.name }}</div>
						<div class="rw-note">{{ s.note }}</div>
					</div>
					<div class="v">
						<span class="a" data-event-click="setting(s.index, -1)">‹</span>
						<span class="val" data-class-chg="s.changed" data-style-animation="s.bump">{{ s.value }}</span>
						<span class="a" data-event-click="setting(s.index, 1)">›</span>
					</div>
				</div>
				<div class="rw tex" data-if="tab == 1 &amp;&amp; tex_note != ''">
					<div class="k">
						<div class="rw-name">Converted textures</div>
						<div class="rw-note">{{ tex_action != '' ? 'Not made yet' : tex_switch == 'Turn on' ? 'Off, kept on disk' : tex_remove ? 'In use' : 'Not available' }}</div>
					</div>
					<div class="v sc">
						<div class="btn small-btn side" data-if="tex_switch != ''" data-event-click="switch_textures()"><span>{{ tex_switch }}</span></div>
						<div class="btn small-btn side" data-if="tex_action != ''" data-event-click="convert_textures()"><span>{{ tex_action }}</span></div>
						<div class="btn small-btn side" data-if="tex_remove" data-event-click="remove_textures()"><span>Remove</span></div>
					</div>
				</div>
				<div class="rw tex" data-if="tab == 0">
					<div class="k">
						<div class="rw-name">Desktop shortcut</div>
						<div class="rw-note">{{ shortcut_note }}</div>
					</div>
					<div class="v sc">
						<img class="sc-icon" src="img/icon.png"/>
						<div class="btn small-btn side" data-event-click="create_shortcut()"><span>Create</span></div>
					</div>
				</div>
			</div>
		</div>
		<div class="band2">Changes are saved as you make them.</div>
		<div class="foot">
			<img class="ficon" src="img/icon.png"/>
			<div class="grow"></div>
			<div class="hint" key="e"><img class="gl" key="q" data-attr-src="glyph_tab_l"/><img class="gl" data-attr-src="glyph_tab_r"/><span>Section</span></div>
			<div class="hint" key="change"><img class="gl" data-attr-src="glyph_change"/><span>Change</span></div>
			<div class="hint" key="back"><img class="gl" data-attr-src="glyph_back"/><span>Back</span></div>
		</div>
	</div>
</div>

</body>
</rml>
