/* Moon River launcher look. Laid out in dp for 1280 x 800 and scaled with the window (app.cpp).
 * Visual tokens:
 *   Night sky:   #030817 -> #071433 (45%) -> #0c2554 (72%) -> #081a3d
 *   River band:  #0a2149 -> #050f28 (70%) -> #030a1d, top edge rgba(160,220,255,.16)
 *   Ink:         #dff7ff   | Muted ink: #8fb3cc / #a9c9dc
 *   Glow cyan:   #6fe6ff   | Deep cyan: #3fb6e0 / #2aa6d8
 *   Warm accent: #ffcf7a   | Hairline:  rgba(111,230,255,.22) (#6fe6ff38)
 */

div, p, h1, h2 { display: block; }
p, h1, h2 { margin: 0; }
span { display: inline; }

body {
	width: 100%;
	height: 100%;
	font-family: "Source Sans 3";
	font-size: 16dp;
	color: #dff7ff;
	background-color: #030817;
}

.stage {
	position: relative;
	width: 100%;
	height: 100%;
	overflow: hidden;
}

.sky {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	decorator: image(gen:grad?d=v&c0=030817&c1=071433&p1=0.45&c2=0c2554&p2=0.72&c3=081a3d fill);
}

.scene-moon {
	position: absolute;
	right: 5dp;
	top: 155dp;
	width: 480dp;
	height: 480dp;
	pointer-events: none;
}

.river {
	position: absolute;
	left: 0;
	bottom: 0;
	width: 100%;
	height: 250dp;
	border-top: 1dp #a0dcff29;
	decorator: image(gen:grad?d=v&c0=0a2149&c1=050f28&p1=0.7&c2=030a1d fill);
	pointer-events: none;
}

.scene-shimmer {
	position: absolute;
	right: 120dp;
	bottom: 40dp;
	width: 250dp;
	height: 210dp;
	pointer-events: none;
}

.vignette {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	decorator: image(gen:vignette fill);
	pointer-events: none;
}

.screen {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	overflow: hidden;
	animation: 0.28s cubic-out fade-in;
}

.screen.leaving {
	animation: 0.20s cubic-in fade-out;
}

.crumb, .lead, .col, .foot, .band2, .btn, .rw, .inp, .log, .update-pill {
	box-sizing: border-box;
}

/* ---- motion ---- */
@keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes fade-out { from { opacity: 1; } to { opacity: 0; } }
@keyframes pulse { from { opacity: 1; } to { opacity: 0.3; } }
@keyframes bump-l-a { 0% { transform: translateX(0); } 35% { transform: translateX(-8dp); } 100% { transform: translateX(0); } }
@keyframes bump-l-b { 0% { transform: translateX(0); } 35% { transform: translateX(-8dp); } 100% { transform: translateX(0); } }
@keyframes bump-r-a { 0% { transform: translateX(0); } 35% { transform: translateX(8dp); } 100% { transform: translateX(0); } }
@keyframes bump-r-b { 0% { transform: translateX(0); } 35% { transform: translateX(8dp); } 100% { transform: translateX(0); } }

/* ---- title screen ---- */
.logo {
	position: absolute;
	left: 50%;
	margin-left: -270dp;
	top: 24dp;
	width: 540dp;
	height: 251dp;
	pointer-events: none;
}

.update-pill {
	position: absolute;
	right: 40dp;
	top: 34dp;
	font-size: 15dp;
	color: #ffcf7a;
	border: 1dp #ffcf7a80;
	border-radius: 18dp;
	padding: 5dp 14dp;
	background-color: #28190040;
	cursor: pointer;
}

.update-pill:hover {
	border-color: #ffcf7a;
	background-color: #3a260066;
}

.menu {
	position: absolute;
	left: 0;
	top: 250dp;
	width: 100%;
	height: 330dp;
}

.mi {
	position: absolute;
	left: 0;
	top: 150dp;
	width: 100%;
	height: 50dp;
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
	transform-origin: center center;
	transition: transform 0.32s cubic-out, opacity 0.32s cubic-out;
	cursor: pointer;
}

.mi.far {
	visibility: hidden;
	pointer-events: none;
}

.mi-halo {
	position: absolute;
	left: 50%;
	margin-left: -170dp;
	top: -18dp;
	width: 340dp;
	height: 86dp;
	transform: scale(0.001);
	pointer-events: none;
	decorator: image(gen:glow?x=0.5&y=0.5&rx=0.5&ry=0.5&c1=3fb6e0&a1=72&c0=3fb6e0&a0=0&stop=1&edge=0.2 fill);
	transition: transform 0.28s cubic-out;
}

.mi.on .mi-halo {
	transform: scale(1);
}

.mi-inner {
	position: relative;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	white-space: nowrap;
}

.mi-label {
	font-family: "Marcellus";
	font-size: 34dp;
	line-height: 50dp;
	color: #bfe6f5;
}

.mi.on .mi-label {
	color: #effcff;
	font-effect: blur(4px #6fe6fff2), blur(14px #6fe6ff99);
}

.mi-tag {
	font-family: "Source Sans 3";
	font-weight: 600;
	font-size: 13dp;
	color: #ffcf7a;
	margin-left: 8dp;
	margin-bottom: 16dp;
}

.mi-line {
	width: 0;
	height: 1dp;
	margin: 0;
	transition: width 0.25s cubic-out, margin 0.25s cubic-out;
}

.mi.on .mi-line {
	width: 70dp;
	margin: 0 22dp;
}

.mi-line.left {
	decorator: image(gen:fade?c=6fe6ff&a=255&d=r fill);
}

.mi-line.right {
	decorator: image(gen:fade?c=6fe6ff&a=255&d=l fill);
}

.desc-wrap {
	position: absolute;
	left: 50%;
	margin-left: -400dp;
	top: 604dp;
	width: 800dp;
	display: flex;
	flex-direction: column;
	align-items: center;
}

.desc-wrap .hline {
	width: 100%;
	height: 1dp;
	decorator: image(gen:fade?c=6fe6ff&a=115&d=c fill);
}

.desc {
	width: 100%;
	text-align: center;
	font-size: 19dp;
	line-height: 28dp;
	color: #cfe9f6;
	padding: 10dp 0;
}

.desc-wrap.bad .desc {
	color: #ffb3bd;
}

/* ---- breadcrumb (shared on non-title screens) ---- */
.crumb {
	position: absolute;
	left: 60dp;
	top: 44dp;
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 14dp;
	font-family: "Marcellus";
	font-size: 22dp;
	color: #9fd3ea;
}

.crumb-icon {
	width: 34dp;
	height: 34dp;
	margin-right: -4dp;
	cursor: pointer;
}

.crumb-home {
	cursor: pointer;
	tab-index: auto;
	nav: auto;
}

.crumb-home:hover, .crumb-home:focus {
	color: #effcff;
}

.crumb-sep {
	width: 26dp;
	height: 1dp;
	background-color: #3fb6e0;
}

.crumb-cur {
	color: #effcff;
	font-effect: blur(8px #6fe6ff99);
}

/* ---- two-column lead + right column (setup, mods, settings) ---- */
.lead {
	position: absolute;
	left: 60dp;
	top: 120dp;
	width: 420dp;
	display: flex;
	flex-direction: column;
}

.settings-lead {
	width: 440dp;
}

.lead h2 {
	font-family: "Marcellus";
	font-weight: 400;
	font-size: 40dp;
	line-height: 44dp;
	margin-bottom: 16dp;
	color: #effcff;
	font-effect: blur(10px #6fe6ff73);
}

.lead p {
	margin-bottom: 12dp;
	font-size: 18dp;
	line-height: 27dp;
	color: #c6e2f1;
}

.lead p em {
	font-style: normal;
	font-weight: 600;
	color: #effcff;
}

.lead p.small {
	font-size: 15dp;
	line-height: 22dp;
	color: #8fb3cc;
}

.col {
	position: absolute;
	left: 560dp;
	top: 120dp;
	width: 660dp;
	height: 550dp;
	display: flex;
	flex-direction: column;
}

.settings-col {
	top: 130dp;
	height: 540dp;
}

.setup-col {
	top: 130dp;
	height: 540dp;
}

.setup-col .fld {
	margin-bottom: 12dp;
}

.setup-col input.inp {
	height: 40dp;
	line-height: 38dp;
}

.setup-col .fld-row .btn {
	height: 40dp;
	line-height: 38dp;
}

.setup-col .acts {
	margin-top: 16dp;
}

/* ---- inputs & buttons ---- */
.fld {
	margin-bottom: 16dp;
}

.fld-label {
	font-size: 15dp;
	color: #a9c9dc;
	margin-bottom: 6dp;
}

.fld-row {
	display: flex;
	flex-direction: row;
	gap: 10dp;
	align-items: center;
}

input.inp {
	flex: 1;
	height: 44dp;
	line-height: 42dp;
	padding: 0 14dp;
	border: 1dp #a0e1ff47;
	border-radius: 4dp;
	background-color: #020a1e99;
	font-size: 16dp;
	color: #dff7ff;
	tab-index: auto;
	nav: auto;
}

input.inp:focus {
	border-color: #6fe6ff;
	background-color: #041230cc;
}

.btn {
	position: relative;
	height: 44dp;
	line-height: 42dp;
	padding: 0 22dp;
	border: 1dp #a0e1ff66;
	border-radius: 4dp;
	background-color: #0a1e4680;
	font-family: "Source Sans 3";
	font-weight: 600;
	font-size: 16dp;
	color: #e3f5ff;
	white-space: nowrap;
	text-align: center;
	cursor: pointer;
	tab-index: auto;
	nav: auto;
}

.btn:hover, .btn:focus {
	border-color: #6fe6ff;
	background-color: #10326eb3;
	color: #ffffff;
}

.btn span {
	position: relative;
}

.btn-glow {
	position: absolute;
	left: -18dp;
	top: -16dp;
	right: -18dp;
	bottom: -16dp;
	pointer-events: none;
	decorator: image(gen:glow?x=0.5&y=0.5&rx=0.5&ry=0.5&c1=6fe6ff&a1=115&c0=6fe6ff&a0=0&stop=1&edge=0.22 fill);
}

.btn.primary {
	border-color: #8af0ff;
	color: #03142e;
	decorator: image(gen:grad?d=v&c0=5fdcff&c1=2aa6d8 fill);
}

.btn.primary:hover, .btn.primary:focus {
	border-color: #c8f9ff;
	color: #020e22;
	decorator: image(gen:grad?d=v&c0=80e6ff&c1=3fb6e0 fill);
}

.btn.small-btn {
	height: 36dp;
	line-height: 34dp;
	padding: 0 18dp;
	font-size: 15dp;
}

.acts {
	display: flex;
	flex-direction: row;
	gap: 12dp;
	margin-top: 20dp;
}

/* ---- checklist (setup) ---- */
.checks {
	margin-top: 8dp;
	border-top: 1dp #6fe6ff38;
}

.ck {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 14dp;
	padding: 10dp 0;
	border-bottom: 1dp #6fe6ff1a;
	font-size: 16dp;
	color: #dff7ff;
}

.ck .d {
	width: 10dp;
	height: 10dp;
	flex-shrink: 0;
	transform: rotate(45deg);
	border: 1.5dp #6f8ea6;
}

.ck.done .d {
	background-color: #6fe6ff;
	border-color: #6fe6ff;
}

.ck.run .d {
	border-color: #ffcf7a;
	animation: 0.8s sine-in-out infinite alternate pulse;
}

.ck.fail .d {
	background-color: #ff6b7a;
	border-color: #ff6b7a;
}

.ck.fail {
	color: #ffb3bd;
}

.ck-text {
	flex: 1;
}

.ck .r {
	color: #8fb3cc;
}

/* ---- build screen ---- */
.steps {
	position: absolute;
	left: 70dp;
	top: 150dp;
	width: 340dp;
	display: flex;
	flex-direction: column;
}

.st {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 14dp;
	height: 46dp;
	font-family: "Marcellus";
	font-size: 21dp;
	color: #5f7f99;
	white-space: nowrap;
}

.st-n {
	font-family: "Source Sans 3";
	font-weight: 600;
	font-size: 14dp;
	width: 22dp;
	color: #5f7f99;
}

.st.done, .st.done .st-n {
	color: #a9d4e8;
}

.st.run, .st.run .st-n {
	color: #effcff;
}

.st.run .st-name {
	font-effect: blur(8px #6fe6ffb3);
}

.st.fail, .st.fail .st-n {
	color: #ffb3bd;
}

.st-tail {
	width: 40dp;
	height: 1dp;
	decorator: image(gen:fade?c=6fe6ff&a=255&d=l fill);
}

.ring-wrap {
	position: absolute;
	left: 440dp;
	top: 150dp;
	width: 400dp;
	height: 400dp;
	pointer-events: none;
}

.ring-disc {
	position: absolute;
	left: 0;
	top: 0;
	width: 400dp;
	height: 400dp;
}

.moon-fill-img {
	position: absolute;
	left: 50dp;
	top: 50dp;
	width: 300dp;
	height: 300dp;
}

.ring-prog {
	position: absolute;
	left: 0;
	top: 0;
	width: 400dp;
	height: 400dp;
	fill-image: gen:glowring?c=6fe6ff&w=3;
}

.pct {
	position: absolute;
	left: 440dp;
	top: 290dp;
	width: 400dp;
	text-align: center;
	font-family: "Marcellus";
	font-size: 84dp;
	line-height: 84dp;
	color: #e8fbff;
	font-effect: blur(4px #6fe6ffe6), blur(14px #6fe6ff8c);
	pointer-events: none;
}

.pct-sym {
	font-size: 34dp;
}

.pctnote {
	position: absolute;
	left: 440dp;
	top: 390dp;
	width: 400dp;
	text-align: center;
	font-size: 16dp;
	color: #a9c9dc;
	pointer-events: none;
}

.log {
	position: absolute;
	left: 900dp;
	top: 150dp;
	width: 330dp;
	height: 390dp;
	border-left: 1dp #6fe6ff38;
	padding-left: 18dp;
	font-size: 13dp;
	line-height: 21dp;
	color: #7fa3bd;
	overflow: hidden;
}

.log-line {
	white-space: nowrap;
	overflow: hidden;
}

.error {
	color: #ffb3bd;
	font-size: 15dp;
	line-height: 22dp;
	margin-bottom: 10dp;
}

.bacts {
	position: absolute;
	left: 0;
	top: 600dp;
	width: 100%;
	display: flex;
	flex-direction: row;
	justify-content: center;
	gap: 14dp;
}

/* ---- rows: mods + settings + setup switches ---- */
.rows {
	display: flex;
	flex-direction: column;
	border-top: 1dp #6fe6ff38;
	min-height: 0;
	flex-shrink: 1;
	overflow-y: auto;
}

scrollbarvertical { width: 6dp; }
scrollbarvertical slidertrack { background-color: #6fe6ff14; }
scrollbarvertical sliderbar { background-color: #6fe6ff66; min-height: 24dp; }
scrollbarvertical sliderbar:hover, scrollbarvertical sliderbar:active { background-color: #6fe6ff; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { width: 0; height: 0; }

.rw {
	position: relative;
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 18dp;
	padding: 12dp 16dp;
	border-bottom: 1dp #6fe6ff1a;
	border-left: 2dp transparent;
	cursor: pointer;
	tab-index: auto;
	nav: vertical;
}

.rw.compact {
	padding: 12dp 0;
	border-left: 0;
}

.rw.tex {
	tab-index: none;
	cursor: default;
}

.rw:focus, .rw.on {
	border-left-color: #6fe6ff;
	decorator: image(gen:grad?c0=6fe6ff&a0=36&c1=6fe6ff&a1=5 fill);
}

.rw.compact:focus {
	decorator: image(gen:grad?c0=6fe6ff&a0=24&c1=6fe6ff&a1=0 fill);
}

.rw .k {
	flex: 1;
	display: flex;
	flex-direction: column;
	gap: 2dp;
}

.rw-name {
	font-family: "Marcellus";
	font-size: 21dp;
	line-height: 26dp;
	color: #e6f8ff;
}

.rw.compact .rw-name {
	font-size: 18dp;
	line-height: 23dp;
}

.rw:focus .rw-name, .rw.on .rw-name {
	color: #ffffff;
	font-effect: blur(8px #6fe6ffb3);
}

.rw-note {
	font-size: 14.5dp;
	line-height: 20dp;
	color: #8fb3cc;
}

/* ---- switches (gen:pill for smooth vector edges) ---- */
.sw {
	position: relative;
	width: 46dp;
	height: 24dp;
	flex-shrink: 0;
	decorator: image(gen:pill?w=92&h=48&c=6f8ea6&l=3 fill);
}

.sw .knob {
	position: absolute;
	left: 4dp;
	top: 4dp;
	width: 16dp;
	height: 16dp;
	decorator: image(gen:pill?w=32&h=32&f=6f8ea6 fill);
	transition: left 0.18s cubic-out;
}

.sw.y {
	decorator: image(gen:pill?w=92&h=48&f=6fe6ff&fa=46&c=6fe6ff&l=3 fill);
}

.sw.y .knob {
	left: 24dp;
	top: 2dp;
	width: 20dp;
	height: 20dp;
	decorator: image(gen:pill?w=40&h=40&f=6fe6ff&glow=5 fill);
}

.kind {
	font-size: 13dp;
	color: #a9c9dc;
	border: 1dp #6fe6ff38;
	border-radius: 12dp;
	padding: 2dp 10dp;
	white-space: nowrap;
}

.empty {
	font-size: 17dp;
	line-height: 25dp;
	color: #8fb3cc;
	padding: 18dp 0;
}

/* mods list navigation back to left buttons */
.mod-row { nav-left: #mods_open; }
#mods_open { nav-right: #mod0; }

/* ---- settings tabs and values ---- */
.stabs {
	position: absolute;
	left: 560dp;
	top: 62dp;
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 8dp;
}

.stabs .t {
	font-family: "Marcellus";
	font-size: 20dp;
	color: #7fa3bd;
	padding: 6dp 16dp;
	border-bottom: 1dp transparent;
	cursor: pointer;
}

.stabs .t:hover {
	color: #cfe9f6;
}

.stabs .t.on {
	color: #effcff;
	border-bottom-color: #6fe6ff;
	font-effect: blur(8px #6fe6ffcc);
}

.tab-gl {
	height: 28dp;
	width: auto;
	cursor: pointer;
}

.rw .v {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 10dp;
	font-size: 17dp;
	color: #effcff;
	white-space: nowrap;
}

.rw .v .a {
	color: #6fe6ff;
	font-size: 22dp;
	padding: 0 6dp;
	cursor: pointer;
}

.rw .v .a:hover {
	color: #ffffff;
}

.rw .v .val {
	min-width: 150dp;
	text-align: center;
}

.rw .v .val.chg {
	color: #ffcf7a;
}

.rw .v.sc {
	gap: 10dp;
}

.sc-icon {
	width: 28dp;
	height: 28dp;
}

/* ---- status band & footer ---- */
.band2 {
	position: absolute;
	left: 0;
	bottom: 62dp;
	width: 100%;
	height: 40dp;
	line-height: 40dp;
	text-align: center;
	font-size: 17dp;
	color: #d6eef9;
	decorator: image(gen:grad?c0=2878b4&a0=0&c1=2878b4&a1=46&p1=0.5&c2=2878b4&a2=0 fill);
}

.foot {
	position: absolute;
	left: 0;
	bottom: 0;
	width: 100%;
	height: 62dp;
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 26dp;
	padding: 0 40dp;
	decorator: image(gen:grad?d=v&c0=010510&a0=0&c1=010510&a1=178 fill);
	font-size: 16dp;
	color: #a9c9dc;
}

.ficon {
	width: 30dp;
	height: 30dp;
	margin-right: -14dp;
}

.foot .fl {
	font-size: 16dp;
	color: #a9c9dc;
}

.foot .grow {
	flex: 1;
}

.hint {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 9dp;
	color: #e3f5ff;
	cursor: pointer;
}

.hint:hover {
	color: #6fe6ff;
}

.gl {
	height: 34dp;
	width: auto;
}
